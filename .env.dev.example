# PostgreSQL Configuration
DATABASE_URL=postgresql://risuai:risuai@127.0.0.1:5432/risuai
POSTGRES_PASSWORD=risuai
RISU_POSTGRES_POOL_MAX=10

# S3 / RustFS Storage Configuration
RISU_STORAGE_TYPE=s3
RISU_S3_ENDPOINT=http://127.0.0.1:9000
RISU_S3_BUCKET=risuai-assets
RISU_S3_ACCESS_KEY_ID=rustfsadmin
RISU_S3_SECRET_ACCESS_KEY=rustfsadmin
RISU_S3_REGION=us-east-1
RISU_S3_FORCE_PATH_STYLE=true
RISU_S3_AUTO_CREATE_BUCKET=true

# Server Configuration
PORT=6001
TRUST_PROXY=1
