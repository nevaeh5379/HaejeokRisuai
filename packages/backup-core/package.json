      "require": "./dist/node/exportJobStore.js",
      "default": "./src/node/exportJobStore.ts"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build:node": "node build.mjs"
  }
}
