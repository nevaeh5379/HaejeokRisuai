      "default": "./src/compatibility.ts"
    },
    "./entryPolicy": {
      "types": "./src/entryPolicy.ts",
      "import": "./src/entryPolicy.ts",
      "require": "./dist/entryPolicy.js",
      "default": "./src/entryPolicy.ts"
    },
    "./portableBranches": {
      "types": "./src/portableBranches.ts",
      "import": "./src/portableBranches.ts",
      "require": "./dist/portableBranches.js",
      "default": "./src/portableBranches.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "import": "./src/api.ts",
      "require": "./dist/api.js",
      "default": "./src/api.ts"
    },
    "./node/databaseStreamStore": {
      "types": "./src/node/databaseStreamStore.ts",
