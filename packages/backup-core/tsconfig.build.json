{
  "compilerOptions": {
    "target": "ES2023",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "src/**/*.cts"]
}
