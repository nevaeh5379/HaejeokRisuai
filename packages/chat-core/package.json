{
  "name": "@risuai/chat-core",
  "private": true,
  "type": "commonjs",
  "main": "./index.cjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "types": "./index.d.cts",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./*": {
      "types": "./*.d.cts",
      "require": "./*.cjs",
      "default": "./*.cjs"
    }
  }
}
