{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".tsbuild",
    "types": ["node"],
    "strict": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "server.cts",
    "http/realtimeEvents.cts",
    "storage/generationAssetStorage.ts",
    "sync/databaseMutations.cts",
    "sync/localBackupImportRecords.ts",
    "sync/storageSyncSqlApply.cts"
  ]
}
