{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".tsbuild",
    "types": ["node"],
    "strict": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["server.cts", "databaseMutations.cts"]
}
