<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_strip_previous"
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_previous_characters"
        android:gravity="center"
        android:text="‹"
        android:textColor="#CCFFFFFF"
        android:textSize="28sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_strip_items"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/widget_strip_next"
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_next_characters"
        android:gravity="center"
        android:text="›"
        android:textColor="#CCFFFFFF"
        android:textSize="28sp"
        android:visibility="gone" />
</LinearLayout>
