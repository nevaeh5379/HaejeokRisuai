    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "markdown-it": "^15.0.1",
    "mnemonist": "^0.40.4",
    "mobile-drag-drop": "3.0.0-rc.0",
    "monaco-editor": "^0.56.0",
    "msgpackr": "2.1.0",
    "mssql": "^12.7.0",
    "node-html-parser": "^9.0.2",
    "ollama": "^0.6.3",
    "openid-client": "^6.8.7",
    "oracledb": "^7.0.1",
    "pdfjs-dist": "^6.2.108",
    "peerjs": "^1.5.5",
    "pg": "^8.23.0",
    "png-chunk-text": "^1.0.0",
    "postcss-selector-parser": "^7.1.5",
    "pyodide": "^314.0.6",
    "rfdc": "^1.4.1",
    "sharp": "^0.35.4",
    "sortablejs": "^1.15.7",
    "streamsaver": "^2.0.6",
    "sucrase": "^3.35.1",
    "sv": "^0.17.0",
    "svelte-awesome-color-picker": "^4.1.3",
    "three": "^0.185.1",
    "tippy.js": "^6.3.7",
    "uuid": "^14.0.2",
    "valibot": "^1.4.2",
    "wasmoon": "^1.16.0",
    "wavefile": "^11.0.0",
    "web-streams-polyfill": "^4.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@rollup/plugin-strip": "^3.0.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@swc/core": "1.16.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "2.11.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/diff": "^8.0.0",
    "@types/libsodium-wrappers-sumo": "^0.8.2",
    "@types/lodash": "^4.17.25",
    "@types/lodash.isequal": "^4.5.8",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.4.0",
    "@types/showdown": "^2.0.6",
    "@types/sortablejs": "^1.15.9",
    "@types/streamsaver": "^2.0.5",
    "@types/three": "^0.185.4",
    "@types/uuid": "^11.0.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "autoprefixer": "^10.5.4",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.15",
    "internal-ip": "^9.0.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "source-map": "^0.8.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "^4.1.11"
  }
}
