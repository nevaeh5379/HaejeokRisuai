{
  "name": "risuai",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:node": "node scripts/dev-node.mjs",
    "dev:server": "node scripts/dev-server.mjs",
    "dev:node-all": "node scripts/dev-node-all.mjs",
    "dev:storage": "docker compose -f docker-compose.dev.yml up -d",
    "dev:storage:down": "docker compose -f docker-compose.dev.yml down",
    "build": "pnpm run build:protocol && node tooling/vite-build.mjs --sourcemap",
    "build:protocol": "tsc -p packages/protocol/tsconfig.json",
    "tauribuild": "vite build",
    "preview": "vite preview",
    "check": "pnpm run check:protocol && svelte-check --tsconfig ./tsconfig.json",
    "check:protocol": "tsc -p packages/protocol/tsconfig.json --noEmit",
    "check:bundle": "node scripts/check-initial-bundle.mjs",
    "test": "pnpm run test:vitest && pnpm run test:node",
    "test:vitest": "vitest run",
    "test:node": "node --test server/node/modelJobs.test.cjs server/node/realtimeEvents.test.cjs",
    "test:cloudflare-ddns": "node --test deploy/rustfs/update-cloudflare.node-test.mjs",
    "test:dynv6-ddns": "node --test deploy/rustfs/update-dynv6.node-test.mjs",
    "test:risuai-installer": "node --test deploy/rustfs/risuai.node-test.mjs",
    "test:rustfs-deploy": "pnpm test:risuai-installer && pnpm test:dynv6-ddns && pnpm test:cloudflare-ddns",
    "tauri": "node tooling/tauri.mjs",
    "buildsite": "vite build --outDir dist",
    "runserver": "cargo run --manifest-path server/rust/Cargo.toml --bin risuai-server --release",
    "runserver:legacy": "node server/node/server.cjs",
    "server:rust:build": "cargo build --manifest-path server/rust/Cargo.toml --release",
    "server:rust:test": "cargo test --manifest-path server/rust/Cargo.toml --workspace",
    "android:sync": "node tooling/android-build.mjs && cap sync android",
    "android:open": "cap open android",
    "android:build:debug": "pnpm run android:sync && cd android && ./gradlew assembleDebug",
    "sync": "node electron/sync",
    "electron": "node electron/dist/electron",
    "hono:build": "vite build --sourcemap && node server/hono/src/utils/postbuild.js"
  },
  "dependencies": {
    "@adobe/css-tools": "4.5.0",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/lib-storage": "^3.1121.0",
    "@breezystack/lamejs": "^1.2.7",
    "@browsermt/bergamot-translator": "^0.4.9",
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.3",
    "@dqbd/tiktoken": "^1.0.22",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/jinja": "^0.5.9",
    "@huggingface/transformers": "^4.2.0",
    "@lucide/svelte": "^1.35.0",
    "@mlc-ai/web-tokenizers": "^0.1.6",
    "@risuai/ccardlib": "^0.4.2",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.3",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli-win32-arm64-msvc": "2.11.4",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-http": "2.5.9",
