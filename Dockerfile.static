FROM node:24-slim AS builder

WORKDIR /app
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

COPY package.json pnpm-lock.yaml ./
RUN corepack enable \
    && corepack install --global pnpm@10.34.1
RUN --mount=type=cache,id=pnpm-static,target=/pnpm/store pnpm install --frozen-lockfile

COPY . .
ARG HAEJEOK_BUILD_NUMBER
ENV HAEJEOK_BUILD_NUMBER=${HAEJEOK_BUILD_NUMBER}
RUN --mount=type=cache,id=pnpm-static,target=/pnpm/store \
    VITE_RISU_LEGAL_CONFIGURED=TRUE pnpm buildsite

FROM caddy:2-alpine

COPY deploy/rustfs/Caddyfile.static /etc/caddy/Caddyfile
COPY --from=builder /app/dist /srv

EXPOSE 6001

