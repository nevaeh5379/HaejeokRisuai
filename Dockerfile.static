FROM node:24-slim AS builder

WORKDIR /app
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server/node/package.json server/node/package.json
RUN corepack enable \
    && corepack install --global pnpm@12.3.4
RUN --mount=type=cache,id=pnpm-static,target=/pnpm/store pnpm install --frozen-lockfile

COPY . .
ARG HAEJEOK_BUILD_NUMBER
ARG VITE_RISU_LEGAL_CONFIGURED
ENV HAEJEOK_BUILD_NUMBER=${HAEJEOK_BUILD_NUMBER}
RUN --mount=type=cache,id=pnpm-static,target=/pnpm/store \
    VITE_RISU_LEGAL_CONFIGURED="${VITE_RISU_LEGAL_CONFIGURED}" pnpm buildsite

FROM caddy:2-alpine

COPY deploy/rustfs/Caddyfile.static /etc/caddy/Caddyfile
COPY --from=builder /app/dist /srv

EXPOSE 6001
